# Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3500
MCP_SERVER_ENV=development

# Database Configuration (SureFinance PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/surefinance_production

# Authentication (DISABLED by default for single-user mode)
# Set DEFAULT_FAMILY_ID to your SureFinance family UUID
DEFAULT_FAMILY_ID=your-family-uuid-here

# If you want to re-enable authentication, uncomment and configure:
# API_KEYS=your-api-key:your-family-uuid
# JWT_SECRET=your-jwt-secret-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
